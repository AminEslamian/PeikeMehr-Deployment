# Copy this file to .env and fill in the values locally. Never commit .env.

# --- Django / core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# --- SMS / OTP ---
SMS_PROVIDER=mock
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=0
SMS_ALLOW_MOCK=True
OTP_EXPIRE_MINUTES=3
OTP_LOG_CODES=True

# --- API / Gunicorn / uploads ---
API_DOCS_PUBLIC=True
GUNICORN_WORKERS=3
MAX_UPLOAD_SIZE_MB=300
MAX_UPLOAD_FILES=20

# --- Object storage (ArvanCloud S3-compatible) ---
# Keep STORAGE_BACKEND=local to use the local media volume, or set it to s3.
STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://s3.ir-central1.arvanstorage.ir
AWS_S3_REGION_NAME=ir-central1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# Private media: URLs are time-limited signed URLs, not public object ACLs.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600
AWS_S3_FILE_OVERWRITE=False
AWS_S3_CACHE_CONTROL=private, max-age=3600
# Optional: only if you put a CDN/custom domain in front of the bucket.
# AWS_S3_CUSTOM_DOMAIN=
